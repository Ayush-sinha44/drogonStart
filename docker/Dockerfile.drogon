FROM ubuntu:22.04

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install build dependencies
RUN apt-get update && apt-get install -y \
    git \
    gcc \
    g++ \
    cmake \
    libjsoncpp-dev \
    uuid-dev \
    openssl \
    libssl-dev \
    zlib1g-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Drogon framework
WORKDIR /tmp
RUN git clone https://github.com/drogonframework/drogon && \
    cd drogon && \
    git submodule update --init && \
    mkdir build && cd build && \
    cmake .. && \
    make -j$(nproc) && \
    make install && \
    ldconfig && \
    cd / && rm -rf /tmp/drogon

# Verify drogon_ctl is installed
RUN drogon_ctl version

# Create workspace
WORKDIR /workspace

# Create non-root user for security
RUN useradd -m -u 1001 -s /bin/bash drogon && \
    chown -R drogon:drogon /workspace

# USER drogon    # ← COMMENTED OUT - causes permission issues
# Run as root instead

CMD ["/bin/bash"]
